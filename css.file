body{
  margin:0;
  font-family:'Poppins',sans-serif;
  background: linear-gradient(120deg, #f9fbe7, #e0f7fa);
  color:#333;
}
.sidebar{
  width:260px;
  height:100vh;
  position:fixed;
  top:0;
  left:0;
  overflow-y:auto;
  padding-top:30px;
  background: linear-gradient(180deg, #c5e1a5, #aed581);
  box-shadow: 3px 0 8px rgba(0,0,0,0.2);
}
.sidebar h2{
  color:#1b5e20;
  text-align:center;
  margin-bottom:40px;
  font-family:'Roboto Slab', serif;
}
.sidebar a{
  display:block;
  color:#1b5e20;
  padding:14px 20px;
  text-decoration:none;
  font-weight:600;
  margin:5px 10px;
  border-radius:8px;
  transition:0.3s;
}
.sidebar a:hover{
  background:#aed581;
  color:#fff;
}

.main{
  margin-left:260px;
  padding:25px;
  min-height:100vh;
}

.card{
  padding:18px;
  border-radius:15px;
  margin:12px 0;
  background:#fffde7;
  color:#333;
  box-shadow:0 8px 20px rgba(0,0,0,0.1);
  transition:0.3s;
}

button{
  padding:10px 18px;
  border:none;
  border-radius:8px;
  font-weight:600;
  cursor:pointer;
  background: linear-gradient(45deg, #aed581, #7cb342);
  color:#fff;
  transition:0.3s;
}

button:hover{
  opacity:0.85;
}

input, select, textarea{
  padding:10px;
  margin:6px 0;
  width:100%;
  border-radius:8px;
  border:1px solid #aaa;
  background:#f1f8e9;
  color:#333;
  font-family:'Poppins', sans-serif;
}

img.medImg{
  width:100%;
  height:150px;
  object-fit:cover;
  border-radius:12px;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-top:10px;
}
th,td{
  padding:12px;
  border-bottom:1px solid #ccc;
  text-align:left;
  color:#333;
}
th{
  border-radius:8px;
}

.page{display:none;}